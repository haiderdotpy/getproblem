# CodeChef
# --------------------------------------------------------------------------- #
def parse_cc_example_pre(text):
    parts = re.split(r"(?im)^\s*(Input|Output)\s*:?\s*$", text)
    sin = sout = ""
    for i in range(1, len(parts) - 1, 2):
        marker = parts[i].lower()
        value = parts[i + 1].strip("\n")
        if marker == "input":
            sin = value
        else:
            sout = value
    return sin.strip("\n"), sout.strip("\n")


def parse_cc_body(body, raw=False):
    soup = BeautifulSoup(body or "", "html.parser")
    sections = {}
    current = "_top"
    order = ["_top"]
    for el in list(soup.children):
        name = getattr(el, "name", None)
        if name in ("h2", "h3"):
            current = el.get_text(strip=True).lower()
            if current not in sections:
                sections[current] = []
                order.append(current)
            continue
        sections.setdefault(current, []).append(el)

    def render(key):
        nodes = sections.get(key)
        if not nodes:
            return None
        return render_nodes(nodes, image_base=CC_BASE, var_math=False) or None

    statement = render("problem statement")
    if not statement:
        top = render("_top")
        statement = top
    constraints = render("constraints")
    input_spec = render("input")
    output_spec = render("output")

    samples = []
    for key in ("example", "sample input", "sample test cases", "sample input 1"):
        nodes = sections.get(key)
        if not nodes:
            continue
        example_html = "".join(str(n) for n in nodes)
        ex_soup = BeautifulSoup(example_html, "html.parser")
        pre = ex_soup.find("pre")
        if pre is not None:
            sin, sout = parse_cc_example_pre(raw_text(pre))
            if sin or sout:
                samples.append((sin, sout))
        if samples:
            break

    note = render("note")
    return statement, input_spec, output_spec, constraints, samples, note


def parse_cc(data, code, raw=False):
    if not isinstance(data, dict):
        raise GetProblemError("CodeChef: unexpected response (not a JSON object)")
    if data.get("status") == "error":
        message = data.get("message") or "problem not found"
        raise GetProblemError(f"CodeChef: {message}")

    title = data.get("problem_name") or code
    time_value = data.get("max_timelimit")
    time_limit = f"{time_value} sec" if time_value else None

    comps = data.get("problemComponents") or {}
    if comps and (comps.get("statement") or comps.get("sampleTestCases")):
        statement = (comps.get("statement") or "").strip()
        input_spec = (comps.get("inputFormat") or "").strip() or None
        output_spec = (comps.get("outputFormat") or "").strip() or None
        constraints = (comps.get("constraints") or "").strip() or None
        samples = []
        notes = []
        for case in comps.get("sampleTestCases") or []:
            sin = (case.get("input") or "").rstrip("\n")
            sout = (case.get("output") or "").rstrip("\n")
            samples.append((sin, sout))
            if case.get("explanation"):
                notes.append(case["explanation"].strip())
        note = "\n\n".join(n for n in notes if n) or None
    else:
        statement, input_spec, output_spec, constraints, samples, note = parse_cc_body(
            data.get("body") or "", raw=raw
        )

    return Problem(
        platform="CodeChef",
        id=code,
        title=title,
        time_limit=time_limit,
        memory_limit=None,
        statement=statement,
        input_spec=input_spec,
        output_spec=output_spec,
        constraints=constraints,
        samples=samples,
        note=note,
        url=f"{CC_BASE}/problems/{code}",
    )


def fetch_cc(code, refresh=False, raw=False):
    path = cache_path("codechef", code, "json")
    if path.exists() and not refresh:
        try:
            text = path.read_text(encoding="utf-8")
        except OSError:
            text = None
    else:
        text = None

    if text is None:
        url = f"{CC_BASE}/api/contests/PRACTICE/problems/{code}"
        headers = {"Accept": "application/json", "Referer": f"{CC_BASE}/problems/{code}"}
        status, text, _final, blocked = request_raw(
            url, platform="CodeChef", headers=headers
        )
        if blocked:
            raise GetProblemError(
                "CodeChef blocked the request (Cloudflare). "
                "Install curl_cffi: pip install curl_cffi"
            )
        if status == 200 and text:
            write_cache("codechef", code, text, "json")
        elif not (status == 404 and text):
            raise GetProblemError(f"CodeChef: HTTP {status} for problem {code}")

    try:
        data = json.loads(text)
    except ValueError:
        raise GetProblemError("CodeChef: unexpected response (invalid JSON)")

    return parse_cc(data, code, raw=raw)


# --------------------------------------------------------------------------- #
# Formatting
# --------------------------------------------------------------------------- #
def render_examples(samples):
    blocks = []
    for i, (sin, sout) in enumerate(samples, 1):
        blocks.append(f"### Input {i}\n```\n{sin}\n```")
        blocks.append(f"### Output {i}\n```\n{sout}\n```")
    return "## Examples\n\n" + "\n\n".join(blocks)


def latex_to_markdown(text):
    """Convert Codeforces $$$...$$$ math delimiters to standard $...$."""
    return re.sub(r"\$\$\$(.+?)\$\$\$", r"$\g<1>$", text, flags=re.DOTALL)


def format_output(problem, samples_only=False, raw=False, convert_dollars=False):
    if samples_only:
        text = render_examples(problem.samples) + "\n"
        if convert_dollars and not raw:
            text = latex_to_markdown(text)
        return text

    if problem.frontend_id is not None:
        parts = [f"# {problem.frontend_id}. {problem.title}"]
    else:
        parts = [f"# {problem.id} - {problem.title}"]

    if problem.time_limit is not None or problem.memory_limit is not None:
        segments = []
        if problem.time_limit is not None:
            segments.append(f"Time limit: {problem.time_limit}")
        if problem.memory_limit is not None:
            segments.append(f"Memory limit: {problem.memory_limit}")
        limit = " | ".join(segments)
        if problem.input_file and problem.input_file.lower() != "standard input":
            limit += f" | Input: {problem.input_file}"
        if problem.output_file and problem.output_file.lower() != "standard output":
            limit += f" | Output: {problem.output_file}"
        if limit:
            parts.append(limit)

    if problem.statement:
        parts.append("## Statement\n\n" + problem.statement)
    if problem.input_spec:
        parts.append("## Input\n\n" + problem.input_spec)
    if problem.constraints:
        parts.append("## Constraints\n\n" + problem.constraints)
    if problem.output_spec:
        parts.append("## Output\n\n" + problem.output_spec)
    if problem.samples:
        parts.append(render_examples(problem.samples))
    if problem.note:
        parts.append("## Note\n\n" + problem.note)
    parts.append(f"URL: {problem.url}")

    text = "\n\n".join(parts).rstrip() + "\n"
    if convert_dollars and not raw:
        text = latex_to_markdown(text)
    return text


# --------------------------------------------------------------------------- #
# Clipboard
# --------------------------------------------------------------------------- #
def to_clipboard(text):
    candidates = (["wl-copy"], ["xclip", "-selection", "clipboard"])
    for cmd in candidates:
        exe = shutil.which(cmd[0])
        if not exe:
            continue
        try:
            proc = subprocess.run(
                [exe] + cmd[1:],
                input=text.encode("utf-8"),
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        except OSError:
            continue
        if proc.returncode == 0:
            return cmd[0]
    return None


