LC_QUERY = (
    "query question($titleSlug: String!) { question(titleSlug: $titleSlug) "
    "{ questionFrontendId title content isPaidOnly exampleTestcaseList } }"
)
_LC_EXAMPLE_HEADING_RE = re.compile(r"^example\s+\d+\s*:?\s*$", re.I)
_LC_EXAMPLE_LINE_RE = re.compile(r"^(Input|Output|Explanation)\s*:\s*(.*)$", re.I)


def lc_slug_map(refresh=False):
    path = cache_path("leetcode", "all", "json")
    if path.exists() and not refresh:
        try:
            if time.time() - path.stat().st_mtime < LC_LIST_TTL:
                return json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            pass
    text = fetch_html(f"{LC_BASE}/api/problems/all/", platform="LeetCode")[0]
    try:
        data = json.loads(text)
    except ValueError:
        raise GetProblemError("LeetCode: could not fetch the problem list")
    write_cache("leetcode", "all", text, "json")
    return data


def lc_slug_for_number(number, refresh=False):
    data = lc_slug_map(refresh)
    for pair in data.get("stat_status_pairs", []):
        stat = pair.get("stat") or {}
        if stat.get("frontend_question_id") == number:
            slug = stat.get("question__title_slug")
            if slug:
                return slug
    raise GetProblemError(f"LeetCode problem {number} not found")


def lc_question(slug, refresh=False):
    path = cache_path("leetcode", slug, "json")
    if path.exists() and not refresh:
        try:
            return json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            pass
    headers = {
        "Content-Type": "application/json",
        "Accept": "application/json",
        "Referer": f"{LC_BASE}/problems/{slug}/",
        "User-Agent": USER_AGENT,
    }
    body = {"query": LC_QUERY, "variables": {"titleSlug": slug}}
    text = fetch_html(
        f"{LC_BASE}/graphql",
        platform="LeetCode",
        method="POST",
        headers=headers,
        json_body=body,
    )[0]
    try:
        data = json.loads(text)
    except ValueError:
        raise GetProblemError("LeetCode: invalid JSON returned by GraphQL")
    write_cache("leetcode", slug, text, "json")
    return data


def parse_lc_example(text):
    inputs, outputs, explanations = [], [], []
    mode = None
    for line in text.splitlines():
        stripped = line.strip()
        if _LC_EXAMPLE_HEADING_RE.match(stripped):
            continue
        match = _LC_EXAMPLE_LINE_RE.match(stripped)
        if match:
            mode = match.group(1).lower()
            value = match.group(2)
            target = {"input": inputs, "output": outputs, "explanation": explanations}[mode]
            if value:
                target.append(value)
            continue
        if mode is not None:
            {"input": inputs, "output": outputs, "explanation": explanations}[mode].append(line)
    return (
        "\n".join(inputs).strip(),
        "\n".join(outputs).strip(),
        "\n".join(explanations).strip(),
    )


def split_lc_content(content):
    soup = BeautifulSoup(content, "html.parser")
    children = list(soup.children)

    constraint_start = None
    for i, child in enumerate(children):
        if getattr(child, "get_text", None) and child.get_text(
            strip=True
        ).lower().startswith("constraints"):
            constraint_start = i
            break

    if constraint_start is None:
        statement_children = children
        constraint_children = []
    else:
        statement_children = children[:constraint_start]
        constraint_children = children[constraint_start + 1:]

    samples = []
    notes = []

    statement_html = "".join(str(c) for c in statement_children)
    stmt_soup = BeautifulSoup(statement_html, "html.parser")

    # LeetCode uses two shapes: older examples in <pre> blocks and newer ones
    # in <div class="example-block"> with Input/Output <p> children.
    candidates = []
    for el in stmt_soup.find_all(["pre", "div"]):
        if el.name == "pre" and "input:" in raw_text(el).lower():
            candidates.append(el)
        elif el.name == "div" and "example-block" in (el.get("class") or []):
            candidates.append(el)

    for el in candidates:
        if el.name == "pre":
            raw = raw_text(el)
        else:
            raw = "\n".join(
                raw_text(c) for c in el.children if getattr(c, "name", None)
            )
        sin, sout, explanation = parse_lc_example(raw)
        if sin or sout:
            samples.append((sin, sout))
            if explanation:
                notes.append(explanation)
            el.decompose()

    # drop leftover "Example N:" labels
    for el in list(stmt_soup.find_all(["p", "h1", "h2", "h3", "h4", "h5", "h6", "div"])):
        text = el.get_text(strip=True)
        if _LC_EXAMPLE_HEADING_RE.match(text):
            el.decompose()

    statement = HtmlRenderer(
        image_base=LC_BASE, code_backticks=True
    ).blocks(stmt_soup).strip()

    constraints = None
    if constraint_children:
        constraints = render_nodes(
            constraint_children, image_base=LC_BASE, code_backticks=True
        ) or None

    note = "\n\n".join(notes) if notes else None
    return statement, constraints, samples, note


def fetch_lc(spec, refresh=False, raw=False):
    slug = spec
    if re.fullmatch(r"\d+", spec):
        slug = lc_slug_for_number(int(spec), refresh)

    data = lc_question(slug, refresh)
    question = (data.get("data") or {}).get("question") if isinstance(data, dict) else None
    if not question:
        raise GetProblemError(f"LeetCode: unexpected response for '{slug}'")
    if question.get("isPaidOnly") or not question.get("content"):
        raise GetProblemError("LeetCode problem is premium; no content available.")

    statement, constraints, samples, note = split_lc_content(question.get("content") or "")
    title = question.get("title") or slug
    frontend_id = str(question.get("questionFrontendId") or spec)

    return Problem(
        platform="LeetCode",
        id=spec,
        title=title,
        time_limit=None,
        memory_limit=None,
        statement=statement,
        input_spec=None,
        output_spec=None,
        constraints=constraints,
        samples=samples,
        note=note,
        url=f"{LC_BASE}/problems/{slug}/",
        frontend_id=frontend_id,
    )


