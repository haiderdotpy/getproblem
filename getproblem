# CLI
# --------------------------------------------------------------------------- #
PREFIX_PLATFORMS = {
    "cf": "codeforces",
    "atc": "atcoder",
    "lc": "leetcode",
    "cc": "codechef",
}

USAGE = """usage: getproblem <id> [--print] [--stdout] [--refresh] [--samples-only] [--raw]

  <id>   any of:
           1831B, 1831/B, 1800F2     Codeforces
           abc300_a, abc300a         AtCoder
           1, two-sum                LeetCode
           FLOW001                   CodeChef
           cf:1A atc:abc300a lc:two-sum cc:FLOW001   (explicit platform)

options:
  --print          copy to the clipboard AND print to stdout
  --stdout         print to stdout only (no clipboard)
  --refresh        ignore the cache and re-fetch
  --samples-only   only output the sample inputs/outputs
  --raw            keep original math delimiters (Codeforces/AtCoder)"""


def detect_target(token):
    match = re.match(r"^(cf|atc|lc|cc):(.+)$", token, re.I)
    if match:
        return PREFIX_PLATFORMS[match.group(1).lower()], match.group(2)

    if re.match(r"^\d+/?[A-Za-z]\d?$", token):
        return "codeforces", token

    match = _ATC_RE.match(token)
    if match and match.group(1).startswith(("abc", "arc", "agc", "ahc")):
        return "atcoder", f"{match.group(1)}_{match.group(2)}"

    if re.match(r"^\d+$", token) or re.match(r"^[a-z0-9]+(-[a-z0-9]+)+$", token):
        return "leetcode", token

    if re.match(r"^[A-Z]+\d+[A-Z]*$", token):
        return "codechef", token

    return None, None


def build_parser():
    parser = argparse.ArgumentParser(
        prog="getproblem",
        add_help=True,
        description="Fetch a Codeforces / AtCoder / LeetCode / CodeChef problem.",
    )
    parser.add_argument("problem", help="problem id, e.g. 1831B, abc300_a, two-sum, FLOW001")
    parser.add_argument("--print", dest="also_print", action="store_true",
                        help="copy to clipboard and also print to stdout")
    parser.add_argument("--stdout", action="store_true",
                        help="print to stdout only, no clipboard")
    parser.add_argument("--refresh", action="store_true",
                        help="bypass the cache")
    parser.add_argument("--samples-only", action="store_true",
                        help="output only the sample inputs/outputs")
    parser.add_argument("--raw", action="store_true",
                        help="keep original math delimiters")
    return parser


def fetch_problem_for(platform, spec, refresh=False, raw=False):
    if platform == "codeforces":
        return fetch_cf(spec, refresh=refresh, raw=raw)
    if platform == "atcoder":
        return fetch_atc(spec, refresh=refresh, raw=raw)
    if platform == "leetcode":
        return fetch_lc(spec, refresh=refresh, raw=raw)
    if platform == "codechef":
        return fetch_cc(spec, refresh=refresh, raw=raw)
    raise GetProblemError(f"unsupported platform '{platform}'")


def main(argv=None):
    args = build_parser().parse_args(argv)

    platform, spec = detect_target(args.problem)
    if platform is None:
        print(USAGE, file=sys.stderr)
        return 2

    migrate_flat_cache()

    try:
        problem = fetch_problem_for(platform, spec, refresh=args.refresh, raw=args.raw)
    except GetProblemError as exc:
        print(f"getproblem: {exc}", file=sys.stderr)
        return 1

    text = format_output(
        problem,
        samples_only=args.samples_only,
        raw=args.raw,
        convert_dollars=(platform == "codeforces"),
    )

    if args.stdout:
        sys.stdout.write(text)
        return 0

    copied = to_clipboard(text)
    if args.also_print:
        sys.stdout.write(text)

    if copied:
        print(
            f"Copied {problem.platform} {problem.id} - {problem.title} "
            f"({len(problem.samples)} samples)",
            file=sys.stderr,
        )
        return 0

    print(
        "getproblem: wl-copy/xclip not found; printing to stdout instead",
        file=sys.stderr,
    )
    if not args.also_print:
        sys.stdout.write(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())
