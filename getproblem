#!/usr/bin/env python3
"""getproblem - fetch a competitive-programming problem statement + samples
to the clipboard.

Supported platforms: Codeforces, AtCoder, LeetCode, CodeChef.

Usage:
    getproblem 1831B            # Codeforces
    getproblem 1831/B
    getproblem cf:1A            # explicit platform prefix
    getproblem abc300_a         # AtCoder
    getproblem atc:abc300a
    getproblem 1                # LeetCode (frontend number)
    getproblem two-sum          # LeetCode (title slug)
    getproblem FLOW001          # CodeChef
    getproblem cc:FLOW001

    getproblem 1831B --print         # copy AND print to stdout
    getproblem 1831B --stdout        # print only, no clipboard
    getproblem 1831B --samples-only
    getproblem 1831B --refresh       # bypass the cache
    getproblem 1831B --raw           # keep original math delimiters
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass, field
from pathlib import Path
from typing import List, Optional, Tuple
from urllib.parse import urljoin

from bs4 import BeautifulSoup, NavigableString

CF_BASE = "https://codeforces.com"
ATC_BASE = "https://atcoder.jp"
LC_BASE = "https://leetcode.com"
CC_BASE = "https://www.codechef.com"

USER_AGENT = (
    "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
    "(KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"
)
TIMEOUT = 15
RETRIES = 2  # retries after the first attempt
LC_LIST_TTL = 7 * 24 * 3600  # LeetCode problem list cached for 7 days

try:
    from curl_cffi import requests as cffi_requests

    HAVE_CFFI = True
except Exception:  # pragma: no cover - optional dependency
    cffi_requests = None
    HAVE_CFFI = False

try:
    import requests as plain_requests

    HAVE_REQUESTS = True
except Exception:  # pragma: no cover - optional dependency
    plain_requests = None
    HAVE_REQUESTS = False


class GetProblemError(Exception):
    """Raised for any user-facing failure."""


@dataclass
class Problem:
    platform: str
    id: str
    title: str
    time_limit: Optional[str]
    memory_limit: Optional[str]
    statement: str
    input_spec: Optional[str]
    output_spec: Optional[str]
    constraints: Optional[str]
    samples: List[Tuple[str, str]] = field(default_factory=list)
    note: Optional[str] = None
    url: str = ""
    # extra fields kept for backwards-compatible Codeforces output
    input_file: Optional[str] = None
    output_file: Optional[str] = None
    frontend_id: Optional[str] = None

    def __getitem__(self, key):  # tiny compatibility shim
        return getattr(self, key)


# --------------------------------------------------------------------------- #
# HTTP
# --------------------------------------------------------------------------- #
def _request(client, url, method="GET", headers=None, json_body=None):
    if client == "cffi":
        return cffi_requests.request(
            method,
            url,
            impersonate="chrome",
            timeout=TIMEOUT,
            headers=headers,
            json=json_body,
        )
    return plain_requests.request(
        method,
        url,
        headers=headers
        or {
            "User-Agent": USER_AGENT,
            "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
            "Accept-Language": "en-US,en;q=0.9",
        },
        timeout=TIMEOUT,
        json=json_body,
    )


def _looks_blocked(text):
    # Only the genuine Cloudflare interstitial / challenge page, not regular
    # Codeforces pages (which reference cloudflare in their scripts).
    markers = (
        "Just a moment",
        "cf-challenge",
        "Enable JavaScript and cookies to continue",
        "Attention Required! | Cloudflare",
    )
    low = text.lower()
    return any(m.lower() in low for m in markers)


def request_raw(url, platform="Codeforces", method="GET", headers=None, json_body=None):
    """Perform a request with retries and client fallback.

    Returns ``(status, text, final_url, blocked)``. Only raises when every
    client fails at the network level or the site is Cloudflare-blocked.
    """
    clients = []
    if HAVE_CFFI:
        clients.append("cffi")
    if HAVE_REQUESTS:
        clients.append("requests")
    if not clients:
        raise GetProblemError(
            "no HTTP client available (install 'curl_cffi' or 'requests')"
        )

    last_err = None
    last_blocked = False
    best = None
    for client in clients:
        for attempt in range(RETRIES + 1):
            try:
                resp = _request(
                    client, url, method=method, headers=headers, json_body=json_body
                )
                status = getattr(resp, "status_code", 0)
                text = resp.text or ""
                final = str(getattr(resp, "url", url))
                blocked = _looks_blocked(text) if text else False
                if status == 200 and text:
                    return status, text, final, blocked
                best = (status, text, final)
                last_err = f"HTTP {status} ({client})"
                if status in (403, 429, 503) or blocked:
                    last_blocked = True
                if status in (400, 401, 404, 410):
                    return status, text, final, last_blocked
            except Exception as exc:  # network errors etc.
                last_err = f"{client}: {exc}"
            if attempt < RETRIES:
                time.sleep(1)

    if last_blocked:
        raise GetProblemError(
            f"{platform} blocked the request (Cloudflare). "
            "Install curl_cffi: pip install curl_cffi"
        )
    if best is not None:
        return best[0], best[1], best[2], False
    raise GetProblemError(f"{platform}: {last_err or 'request failed'}")


def fetch_html(url, platform="Codeforces", method="GET", headers=None, json_body=None):
    """Return (html, final_url, blocked) or raise GetProblemError."""
    status, text, final, blocked = request_raw(
        url, platform=platform, method=method, headers=headers, json_body=json_body
    )
    if status == 200 and text:
        return text, final, blocked
    if blocked:
        raise GetProblemError(
            f"{platform} blocked the request (Cloudflare). "
            "Install curl_cffi: pip install curl_cffi"
        )
    raise GetProblemError(f"{platform}: HTTP {status}")


# --------------------------------------------------------------------------- #
# Cache (per platform)
# --------------------------------------------------------------------------- #
def cache_root():
    root = os.environ.get("XDG_CACHE_HOME") or str(Path.home() / ".cache")
    return Path(root) / "getproblem"


def cache_path(platform, key, ext="html"):
    return cache_root() / platform / f"{key}.{ext}"


def write_cache(platform, key, content, ext="html"):
    path = cache_path(platform, key, ext)
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content, encoding="utf-8")
    except OSError:
        pass


def get_cached(platform, key, fetch, ext="html", refresh=False):
    path = cache_path(platform, key, ext)
    if path.exists() and not refresh:
        try:
            return path.read_text(encoding="utf-8")
        except OSError:
            pass
    content = fetch()
    write_cache(platform, key, content, ext)
    return content


def migrate_flat_cache():
    """Move legacy flat codeforces cache files into the per-platform dir."""
    root = cache_root()
    if not root.is_dir():
        return
    dest = root / "codeforces"
    for old in root.glob("*.html"):
        target = dest / old.name
        try:
            if target.exists():
                old.unlink()
            else:
                dest.mkdir(parents=True, exist_ok=True)
                old.replace(target)
        except OSError:
            pass


# --------------------------------------------------------------------------- #
# HTML -> text rendering
# --------------------------------------------------------------------------- #
_INLINE_BLOCKS = {
    "p", "h1", "h2", "h3", "h4", "h5", "h6", "blockquote", "dt", "dd",
    "td", "th", "caption", "figcaption", "summary", "address",
}

_CONTAINERS = {
    "div", "section", "article", "li", "table", "thead", "tbody", "tfoot",
    "tr", "dl", "form", "details", "figure", "main", "header", "footer",
    "aside", "nav",
}


def strip_math_wrappers(text):
    text = text.strip()
    if text.startswith("\\(") and text.endswith("\\)"):
        text = text[2:-2].strip()
    return text


class HtmlRenderer:
    """Convert an HTML subtree to markdown-ish plain text.

    Defaults reproduce the original Codeforces behaviour:
    ``$$$...$$$`` tracking, no ``<var>`` math, literal ``<code>``.
    """

    def __init__(
        self,
        image_base=CF_BASE,
        var_math=False,
        code_backticks=False,
        track_math=False,
    ):
        self.image_base = image_base
        self.var_math = var_math
        self.code_backticks = code_backticks
        self.track_math = track_math
        self.in_math = False

    def _track_math(self, text):
        if self.track_math and text.count("$$$") % 2 == 1:
            self.in_math = not self.in_math

    def _inline_node(self, child):
        if isinstance(child, NavigableString):
            s = str(child)
            self._track_math(s)
            return re.sub(r"\s+", " ", s)
        if child.name == "br":
            return "\n"
        if child.name == "img":
            src = child.get("src") or child.get("data-src") or ""
            return (
                f"[image: {urljoin(self.image_base + '/', src)}]"
                if src
                else "[image]"
            )
        if child.name in ("sub", "sup"):
            inner = self.inline(child).strip()
            if self.track_math and self.in_math:
                return inner
            return ("_" if child.name == "sub" else "^") + inner
        if child.name == "var":
            inner = strip_math_wrappers(re.sub(r"\s+", " ", child.get_text())).strip()
            return f"${inner}$" if self.var_math else inner
        if child.name == "code":
            inner = self.inline(child).strip()
            return f"`{inner}`" if self.code_backticks else inner
        return self.inline(child)

    def inline(self, node):
        out = [self._inline_node(child) for child in node.children]
        text = re.sub(r"[ \t]{2,}", " ", "".join(out))
        return re.sub(r"[ \t]*\n[ \t]*", "\n", text)

    def blocks(self, container):
        blocks = []
        buf = []

        def flush():
            if not buf:
                return
            text = re.sub(r"[ \t]*\n[ \t]*", "\n", re.sub(r"[ \t]{2,}", " ", "".join(buf)))
            text = text.strip()
            if text:
                blocks.append(text)
            buf.clear()

        for child in container.children:
            if isinstance(child, NavigableString):
                s = str(child)
                self._track_math(s)
                buf.append(re.sub(r"\s+", " ", s))
            elif child.name == "br":
                buf.append("\n")
            elif child.name == "pre":
                flush()
                blocks.append("```\n" + pre_text(child, var_math=self.var_math) + "\n```")
            elif child.name in ("ul", "ol"):
                flush()
                items = []
                for li in child.find_all("li", recursive=False):
                    items.append("- " + self.inline(li).strip())
                if items:
                    blocks.append("\n".join(items))
            elif child.name in _INLINE_BLOCKS:
                flush()
                s = self.inline(child).strip()
                if s:
                    blocks.append(s)
            elif child.name in _CONTAINERS:
                cls = child.get("class") or []
                if "section-title" in cls:
                    continue
                flush()
                sub = self.blocks(child)
                if sub.strip():
                    blocks.append(sub.strip())
            elif child.name is not None:
                buf.append(self._inline_node(child))
        flush()
        return "\n\n".join(b for b in blocks if b.strip())


def raw_text(node, var_math=False, raw=False):
    out = []
    for child in node.children:
        if isinstance(child, NavigableString):
            out.append(str(child))
        elif child.name == "br":
            out.append("\n")
        elif child.name == "var" and var_math and not raw:
            inner = strip_math_wrappers(raw_text(child)).strip()
            out.append(f"${inner}$")
        else:
            out.append(raw_text(child, var_math=var_math, raw=raw))
    return "".join(out)


def pre_text(pre, var_math=False, raw=False):
    lines = pre.select("div.test-example-line")
    if lines:
        return "\n".join(raw_text(line).strip("\r\n") for line in lines)
    txt = raw_text(pre, var_math=var_math, raw=raw)
    if txt.startswith("\n"):
        txt = txt[1:]
    return txt.rstrip("\n")


def header_prop(header, cls):
    el = header.select_one(f".{cls}") if header else None
    if el is None:
        return ""
    for title in el.select(".property-title"):
        title.extract()
    return re.sub(r"\s+", " ", el.get_text()).strip()


def render_html(html, *, image_base, var_math=False, code_backticks=False, track_math=False):
    soup = BeautifulSoup(html, "html.parser")
    return HtmlRenderer(
        image_base=image_base,
        var_math=var_math,
        code_backticks=code_backticks,
        track_math=track_math,
    ).blocks(soup).strip()


def render_nodes(nodes, *, image_base, var_math=False, code_backticks=False):
    html = "".join(str(n) for n in nodes)
    return render_html(
        html,
        image_base=image_base,
        var_math=var_math,
        code_backticks=code_backticks,
    )


# --------------------------------------------------------------------------- #
# Codeforces
# --------------------------------------------------------------------------- #
ID_RE = re.compile(r"^(\d+)/?([A-Za-z]\d?)$")


def fetch_problem(contest, index):
    """Try the contest URL, then the problemset URL. Returns (html, url)."""
    urls = [
        f"{CF_BASE}/contest/{contest}/problem/{index}",
        f"{CF_BASE}/problemset/problem/{contest}/{index}",
    ]
    blocked = False
    for url in urls:
        try:
            html, _final, was_blocked = fetch_html(url)
        except GetProblemError as exc:
            if "Cloudflare" in str(exc):
                blocked = True
            continue
        if _has_statement(html):
            return html, url
        blocked = blocked or was_blocked

    if blocked:
        raise GetProblemError(
            "Codeforces blocked the request (Cloudflare). "
            "Try again, or ensure curl_cffi is installed: pip install curl_cffi"
        )
    raise GetProblemError(f"problem {contest}{index} not found")


def _has_statement(html):
    return "problem-statement" in html and (
        BeautifulSoup(html, "html.parser").select_one("div.problem-statement")
        is not None
    )


def parse_cf(html, contest, index):
    soup = BeautifulSoup(html, "html.parser")
    ps = soup.select_one("div.problem-statement")
    if ps is None:
        raise GetProblemError(
            "Codeforces: could not parse the problem statement "
            "(page layout changed or blocked)"
        )

    header = ps.select_one("div.header")
    raw_title = header_prop(header, "title") if header else ""
    title = re.sub(r"^[A-Za-z]\d?\.\s*", "", raw_title).strip() or raw_title
    time_limit = header_prop(header, "time-limit") or None
    memory_limit = header_prop(header, "memory-limit") or None
    input_file = header_prop(header, "input-file") or None
    output_file = header_prop(header, "output-file") or None

    legend = None
    for div in ps.find_all("div", recursive=False):
        cls = div.get("class") or []
        if "header" in cls:
            continue
        if not cls:
            legend = div
            break

    input_spec = ps.select_one("div.input-specification")
    output_spec = ps.select_one("div.output-specification")
    note = ps.select_one("div.note")

    samples = []
    for sample in ps.select("div.sample-test"):
        ins = sample.select("div.input pre")
        outs = sample.select("div.output pre")
        count = max(len(ins), len(outs))
        for i in range(count):
            samples.append(
                (
                    pre_text(ins[i]) if i < len(ins) else "",
                    pre_text(outs[i]) if i < len(outs) else "",
                )
            )

    return Problem(
        platform="Codeforces",
        id=f"{contest}{index}",
        title=title,
        time_limit=time_limit,
        memory_limit=memory_limit,
        statement=HtmlRenderer(track_math=True).blocks(legend) if legend else "",
        input_spec=HtmlRenderer(track_math=True).blocks(input_spec) if input_spec else "",
        output_spec=HtmlRenderer(track_math=True).blocks(output_spec) if output_spec else "",
        constraints=None,
        samples=samples,
        note=HtmlRenderer(track_math=True).blocks(note) if note else "",
        url=f"{CF_BASE}/contest/{contest}/problem/{index}",
        input_file=input_file,
        output_file=output_file,
    )


def fetch_cf(spec, refresh=False, raw=False):
    match = ID_RE.match(spec)
    if not match:
        raise GetProblemError(f"Codeforces: invalid problem id '{spec}'")
    contest = match.group(1)
    index = match.group(2).upper()
    html = get_cached(
        "codeforces",
        f"{contest}{index}",
        lambda: fetch_problem(contest, index)[0],
        ext="html",
        refresh=refresh,
    )
    return parse_cf(html, contest, index)


# --------------------------------------------------------------------------- #
# AtCoder
# --------------------------------------------------------------------------- #
_ATC_RE = re.compile(r"^([a-z]+\d+)_?([a-z0-9]+)$")


def normalize_atc(token):
    match = _ATC_RE.match(token)
    if match:
        return f"{match.group(1)}_{match.group(2)}"
    return token


def _atc_url(contest, suffix):
    return f"{ATC_BASE}/contests/{contest}/tasks/{contest}_{suffix}?lang=en"


def _atc_fetch_task(contest, suffix, letter):
    direct = _atc_url(contest, suffix)
    try:
        html = fetch_html(direct, platform="AtCoder")[0]
        if BeautifulSoup(html, "html.parser").select_one("#task-statement"):
            return html, direct
    except GetProblemError as exc:
        if "Cloudflare" in str(exc):
            raise

    tasks_url = f"{ATC_BASE}/contests/{contest}/tasks?lang=en"
    try:
        listing = fetch_html(tasks_url, platform="AtCoder")[0]
    except GetProblemError:
        raise GetProblemError(f"AtCoder: task {contest}_{suffix} not found")

    soup = BeautifulSoup(listing, "html.parser")
    wanted = letter.upper()
    for row in soup.select("table tbody tr"):
        cells = row.find_all("td")
        link = row.find("a")
        if not cells or link is None:
            continue
        if cells[0].get_text(strip=True).upper() == wanted:
            href = link.get("href") or ""
            url = urljoin(ATC_BASE + "/", href)
            if "lang=" not in url:
                url += ("&" if "?" in url else "?") + "lang=en"
            try:
                page = fetch_html(url, platform="AtCoder")[0]
            except GetProblemError as exc:
                raise GetProblemError(f"AtCoder: could not load {url}: {exc}")
            return page, url

    raise GetProblemError(f"AtCoder: task {contest}_{suffix} not found")


def classify_atc_heading(heading):
    key = heading.strip().lower()
    if key.startswith("sample input") or heading.strip().startswith("入力例"):
        return "sample-in"
    if key.startswith("sample output") or heading.strip().startswith("出力例"):
        return "sample-out"
    if key == "problem statement" or heading.strip() == "問題文":
        return "statement"
    if key == "constraints" or heading.strip() == "制約":
        return "constraints"
    if key == "input" or heading.strip() == "入力":
        return "input"
    if key == "output" or heading.strip() == "出力":
        return "output"
    if key == "note" or heading.strip() == "注意":
        return "note"
    return None


def parse_atc(html, spec, url, raw=False):
    soup = BeautifulSoup(html, "html.parser")

    title = ""
    if soup.title:
        title = soup.title.get_text(strip=True)
    title = re.sub(r"^[A-Za-z]\d*\s*-\s*", "", title).strip() or title

    time_limit = memory_limit = None
    for p in soup.find_all("p"):
        text = p.get_text(" ", strip=True)
        match = re.search(
            r"Time Limit:\s*([^/]+?)\s*/\s*Memory Limit:\s*(.+?)\s*$", text
        )
        if match:
            time_limit = match.group(1).strip()
            memory_limit = match.group(2).strip()
            break

    en = soup.select_one("#task-statement span.lang-en")
    if en is None:
        en = soup.select_one("#task-statement")
    if en is None:
        raise GetProblemError(
            "AtCoder: could not parse the task statement (page layout changed)"
        )

    sections = {}
    sample_in = {}
    sample_out = {}
    note_parts = []

    for part in en.select("div.part"):
        h3 = part.find(["h3", "h2"])
        heading = h3.get_text(strip=True) if h3 else ""
        if h3 is not None:
            content = list(h3.next_siblings)
        else:
            content = list(part.children)
        num = re.search(r"(\d+)", heading)
        idx = int(num.group(1)) if num else None
        key = classify_atc_heading(heading)
        if key == "sample-in":
            sample_in[idx if idx is not None else 1] = content
        elif key == "sample-out":
            sample_out[idx if idx is not None else 1] = content
        elif key == "statement":
            sections["statement"] = content
        elif key == "constraints":
            sections["constraints"] = content
        elif key == "input":
            sections["input"] = content
        elif key == "output":
            sections["output"] = content
        elif key == "note":
            note_parts.append(content)

    def render(key):
        nodes = sections.get(key)
        if not nodes:
            return None
        return render_nodes(nodes, image_base=ATC_BASE, var_math=not raw) or None

    def sample_pre(nodes):
        if not nodes:
            return ""
        node_soup = BeautifulSoup("".join(str(n) for n in nodes), "html.parser")
        pre = node_soup.find("pre")
        if pre is not None:
            return pre_text(pre, var_math=True, raw=raw).strip("\n")
        return render_nodes(nodes, image_base=ATC_BASE, var_math=True)

    indices = sorted(set(sample_in) | set(sample_out))
    samples = [
        (sample_pre(sample_in.get(i)), sample_pre(sample_out.get(i)))
        for i in indices
    ]

    note = None
    if note_parts:
        rendered = [
            render_nodes(nodes, image_base=ATC_BASE, var_math=not raw)
            for nodes in note_parts
        ]
        note = "\n\n".join(r for r in rendered if r) or None

    return Problem(
        platform="AtCoder",
        id=spec,
        title=title,
        time_limit=time_limit,
        memory_limit=memory_limit,
        statement=render("statement") or "",
        input_spec=render("input"),
        output_spec=render("output"),
        constraints=render("constraints"),
        samples=samples,
        note=note,
        url=url,
    )


def fetch_atc(spec, refresh=False, raw=False):
    spec = normalize_atc(spec)
    contest, _, suffix = spec.partition("_")
    if not contest or not suffix:
        raise GetProblemError(f"AtCoder: invalid task id '{spec}'")

    path = cache_path("atcoder", spec, "json")
    html = None
    url = _atc_url(contest, suffix)
    if path.exists() and not refresh:
        try:
            obj = json.loads(path.read_text(encoding="utf-8"))
            html = obj.get("html") or None
            url = obj.get("url") or url
        except (OSError, ValueError):
            html = None

    if not html:
        html, url = _atc_fetch_task(contest, suffix, suffix)
        write_cache(
            "atcoder", spec, json.dumps({"url": url, "html": html}), "json"
        )

    return parse_atc(html, spec, url, raw=raw)


